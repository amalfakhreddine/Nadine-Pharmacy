rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && (
        request.auth.uid == "pDtFVJRVIDhVWQTm0XWnbgFwfyG2" ||
        request.auth.token.email == "nadinepharmacy@gmail.com"
      );
    }

    match /orders/{orderId} {
      // Emergency production fix: the admin dashboard may read orders even if
      // Vercel opens its listener before the Firebase token is attached.
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.status in ["New", "New pickup"]
        && request.resource.data.fulfillment in ["delivery", "pickup"]
        && request.resource.data.unread == true
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0;
      allow update, delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /profiles/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == userId);
    }

    match /wishlists/{userId} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == userId;
    }

    match /settings/adminAccess {
      allow read, create, update, delete: if isAdmin();
    }

    match /settings/{documentId} {
      allow read: if documentId != "adminAccess";
      allow create, update, delete: if isAdmin() && documentId != "adminAccess";
    }

    match /reviews/{reviewId} {
      allow read: if isAdmin() || resource.data.status == "approved" ||
        (signedIn() && resource.data.customerUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.status == "pending";
      allow update, delete: if isAdmin();
    }

    match /adminPushTokens/{tokenDoc} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.token is string
        && request.resource.data.active == true;
      allow update: if isAdmin()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.token is string
        && request.resource.data.active == true;
      allow delete: if isAdmin() && resource.data.uid == request.auth.uid;
    }

    match /notificationEvents/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /auditLogs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }
  }
}
