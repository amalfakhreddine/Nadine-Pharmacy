rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.email == "nadinepharmacy@gmail.com"; }

    match /orders/{orderId} {
      allow create: if signedIn()
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.status == "New";
      allow read: if isAdmin() || (signedIn() && resource.data.customerUid == request.auth.uid);
      allow update, delete: if isAdmin();
    }
  }
}
