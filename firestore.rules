rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function primaryAdmin() {
      return signedIn()
        && request.auth.token.email == "nadinepharmacy@gmail.com";
    }
    function configuredAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/settings/adminAccess)
        && get(/databases/$(database)/documents/settings/adminAccess).data.adminEmails is list
        && get(/databases/$(database)/documents/settings/adminAccess).data.adminEmails.hasAny([request.auth.token.email]);
    }
    function isAdmin() { return primaryAdmin() || configuredAdmin(); }

    match /orders/{orderId} {
      allow create: if signedIn()
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.status in ["New", "New pickup"]
        && request.resource.data.fulfillment in ["delivery", "pickup"]
        && ((request.resource.data.fulfillment == "delivery" && request.resource.data.status == "New")
          || (request.resource.data.fulfillment == "pickup" && request.resource.data.status == "New pickup"))
        && request.resource.data.unread == true
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && (!request.resource.data.requiresPrescription || (request.resource.data.prescriptionImage is string && request.resource.data.prescriptionImage.size() > 100));
      allow read: if isAdmin() || (signedIn() && resource.data.customerUid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'updatedAt'])
        && request.resource.data.stock is number
        && request.resource.data.stock >= 0
        && request.resource.data.stock < resource.data.stock
      );
    }

    match /profiles/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == userId);
    }

    match /wishlists/{userId} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == userId;
    }

    match /settings/adminAccess {
      allow read, create, update, delete: if primaryAdmin();
    }

    match /settings/{documentId} {
      allow read: if documentId != 'adminAccess';
      allow create, update, delete: if isAdmin();
    }

    // Customers may queue exactly one fixed-recipient admin email for their own new order.
    // Firebase's Trigger Email extension sends it securely using its server credentials.
    match /mail/{mailId} {
      allow create: if signedIn()
        && request.resource.data.to == ["amalfakhreddinem@gmail.com"]
        && request.resource.data.orderId is string
        && mailId == "order-" + request.resource.data.orderId
        && request.resource.data.message.subject is string
        && request.resource.data.message.subject.matches('^New Nadine Parapharm order .*')
        && request.resource.data.message.text is string
        && request.resource.data.message.html is string;
      allow read, update, delete: if false;
    }

    match /reviews/{reviewId} {
      allow read: if isAdmin()
        || resource.data.status == 'approved'
        || (signedIn() && resource.data.customerUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.verifiedPurchase == true
        && request.resource.data.orderId is string
        && exists(/databases/$(database)/documents/orders/$(request.resource.data.orderId))
        && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.customerUid == request.auth.uid
        && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.status in ['Delivered', 'Collected']
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.deliveryRating is number
        && request.resource.data.deliveryRating >= 1 && request.resource.data.deliveryRating <= 5
        && request.resource.data.packagingRating is number
        && request.resource.data.packagingRating >= 1 && request.resource.data.packagingRating <= 5
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 3
        && request.resource.data.text.size() <= 500;
      allow update, delete: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

  }
}
