rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function primaryAdmin() {
      return signedIn() && request.auth.token.email == "nadinepharmacy@gmail.com";
    }
    function configuredAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/settings/adminAccess)
        && get(/databases/$(database)/documents/settings/adminAccess).data.adminEmails is list
        && get(/databases/$(database)/documents/settings/adminAccess).data.adminEmails.hasAny([request.auth.token.email]);
    }
    function isAdmin() { return primaryAdmin() || configuredAdmin(); }

    match /orders/{orderId} {
      allow create: if signedIn()
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.status in ["New", "New pickup"]
        && request.resource.data.fulfillment in ["delivery", "pickup"]
        && request.resource.data.unread == true
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0;
      allow read: if isAdmin() || (signedIn() && resource.data.customerUid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /profiles/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == userId);
    }

    match /wishlists/{userId} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == userId;
    }

    match /settings/adminAccess {
      allow read, create, update, delete: if primaryAdmin();
    }

    match /settings/{documentId} {
      allow read: if documentId != 'adminAccess';
      allow create, update, delete: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if isAdmin() || resource.data.status == 'approved' || (signedIn() && resource.data.customerUid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.customerUid == request.auth.uid && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }
  }
}
