rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function authEmail() {
      return signedIn() && request.auth.token.email is string
        ? request.auth.token.email.lower()
        : "";
    }
    function fallbackAdmin() {
      return signedIn()
        && authEmail() == "nadinepharmacy@gmail.com"
        && !exists(/databases/$(database)/documents/settings/adminAccess);
    }
    function configuredAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/settings/adminAccess)
        && get(/databases/$(database)/documents/settings/adminAccess).data.adminEmails is list
        && get(/databases/$(database)/documents/settings/adminAccess).data.adminEmails.hasAny([authEmail()]);
    }
    function isAdmin() { return fallbackAdmin() || configuredAdmin(); }
    function validAdminAccess() {
      return request.resource.data.adminEmails is list
        && request.resource.data.adminEmails.size() > 0
        && request.resource.data.adminEmails.size() <= 25;
    }

    match /orders/{orderId} {
      allow create: if signedIn()
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.status == "New"
        && request.resource.data.unread == true
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && (!request.resource.data.requiresPrescription || (request.resource.data.prescriptionImage is string && request.resource.data.prescriptionImage.size() > 100));
      allow read: if isAdmin() || (signedIn() && resource.data.customerUid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'updatedAt'])
        && request.resource.data.stock is number
        && request.resource.data.stock >= 0
        && request.resource.data.stock < resource.data.stock
      );
    }

    match /profiles/{userId} {
      // Every signed-in customer owns their profile document at profiles/{uid}.
      // This permits create and partial merge updates from the customer website.
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.email == request.auth.token.email;
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == userId);
    }

    match /wishlists/{userId} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == userId;
    }

    match /settings/adminAccess {
      allow read: if isAdmin();
      allow create: if fallbackAdmin() && validAdminAccess();
      allow update: if isAdmin() && validAdminAccess();
      allow delete: if false;
    }

    match /settings/adminProfile {
      allow read, create, update: if isAdmin();
      allow delete: if false;
    }

    match /settings/{documentId} {
      allow read: if documentId != 'adminAccess';
      allow create, update, delete: if isAdmin();
    }
  }
}
